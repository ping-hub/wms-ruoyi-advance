<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wms.mapper.ReceiptOrderDetailMapper">

    <resultMap id="receiptDetailVoMap" type="com.ruoyi.wms.domain.vo.ReceiptOrderDetailVo">
        <id property="id" column="id" />
        <result property="receiptOrderId" column="receipt_order_id" />
        <result property="skuId" column="sku_id" />
        <result property="quantity" column="quantity" />
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="skuName" column="sku_name" />
        <result property="unit" column="unit" />
        <result property="productIdentifier" column="product_identifier" />
        <result property="qualityGrade" column="quality_grade" />
        <result property="unitPrice" column="unit_price" />
        <result property="lineAmount" column="line_amount" />
        <result property="remark" column="remark" />
        <result property="boxCode" column="box_code" />
        <result property="instanceCode" column="instance_code" />
        <result property="warehouseId" column="warehouse_id" />
        <result property="areaId" column="area_id" />
        <result property="rackId" column="rack_id" />
        <result property="locationId" column="location_id" />
        <association property="receiptOrder" javaType="com.ruoyi.wms.domain.vo.ReceiptOrderVo">
            <result property="receiptOrderNo" column="receipt_order_no" />
            <result property="warehouseId" column="ro_warehouse_id" />
            <result property="areaId" column="ro_area_id" />
        </association>
    </resultMap>

    <select id="queryDetailPage" resultMap="receiptDetailVoMap">
        SELECT
            d.*,
            ro.receipt_order_no,
            ro.warehouse_id  AS ro_warehouse_id,
            ro.area_id       AS ro_area_id
        FROM wms_receipt_order_detail d
        INNER JOIN wms_receipt_order ro ON d.receipt_order_id = ro.id
        <where>
            <if test="bo.receiptOrderNo != null and bo.receiptOrderNo != ''">
                AND ro.receipt_order_no LIKE concat('%', #{bo.receiptOrderNo}, '%')
            </if>
            <if test="bo.itemName != null and bo.itemName != ''">
                AND d.item_name LIKE concat('%', #{bo.itemName}, '%')
            </if>
            <if test="bo.itemCode != null and bo.itemCode != ''">
                AND d.item_code LIKE concat('%', #{bo.itemCode}, '%')
            </if>
            <if test="bo.instanceCode != null and bo.instanceCode != ''">
                AND d.instance_code LIKE concat('%', #{bo.instanceCode}, '%')
            </if>
            <if test="bo.receiptOrderId != null">
                AND d.receipt_order_id = #{bo.receiptOrderId}
            </if>
            <if test="bo.warehouseId != null">
                AND d.warehouse_id = #{bo.warehouseId}
            </if>
            <if test="bo.areaId != null">
                AND d.area_id = #{bo.areaId}
            </if>
            <if test="bo.startTime != null and bo.startTime != ''">
                AND d.create_time &gt;= #{bo.startTime}
            </if>
            <if test="bo.endTime != null and bo.endTime != ''">
                AND d.create_time &lt;= #{bo.endTime}
            </if>
        </where>
        ORDER BY d.create_time DESC
    </select>

</mapper>
