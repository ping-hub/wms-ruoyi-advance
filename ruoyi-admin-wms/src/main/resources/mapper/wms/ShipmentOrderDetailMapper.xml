<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wms.mapper.ShipmentOrderDetailMapper">

    <resultMap id="shipmentDetailVoMap" type="com.ruoyi.wms.domain.vo.ShipmentOrderDetailVo">
        <id property="id" column="id" />
        <result property="shipmentOrderId" column="shipment_order_id" />
        <result property="skuId" column="sku_id" />
        <result property="quantity" column="quantity" />
        <result property="itemCode" column="item_code" />
        <result property="itemName" column="item_name" />
        <result property="skuName" column="sku_name" />
        <result property="unit" column="unit" />
        <result property="productIdentifier" column="product_identifier" />
        <result property="qualityGrade" column="quality_grade" />
        <result property="unitPrice" column="unit_price" />
        <result property="lineAmount" column="line_amount" />
        <result property="remark" column="remark" />
        <result property="instanceCode" column="instance_code" />
        <result property="warehouseId" column="warehouse_id" />
        <result property="areaId" column="area_id" />
        <result property="inventoryDetailId" column="inventory_detail_id" />
        <result property="boxId" column="box_id" />
        <result property="boxCode" column="box_code" />
        <association property="shipmentOrder" javaType="com.ruoyi.wms.domain.vo.ShipmentOrderVo">
            <result property="shipmentOrderNo" column="shipment_order_no" />
            <result property="warehouseId" column="so_warehouse_id" />
            <result property="areaId" column="so_area_id" />
        </association>
    </resultMap>

    <select id="queryDetailPage" resultMap="shipmentDetailVoMap">
        SELECT
            d.*,
            so.shipment_order_no,
            so.warehouse_id  AS so_warehouse_id,
            so.area_id       AS so_area_id
        FROM wms_shipment_order_detail d
        INNER JOIN wms_shipment_order so ON d.shipment_order_id = so.id
        <where>
            <if test="bo.shipmentOrderNo != null and bo.shipmentOrderNo != ''">
                AND so.shipment_order_no LIKE concat('%', #{bo.shipmentOrderNo}, '%')
            </if>
            <if test="bo.itemName != null and bo.itemName != ''">
                AND d.item_name LIKE concat('%', #{bo.itemName}, '%')
            </if>
            <if test="bo.itemCode != null and bo.itemCode != ''">
                AND d.item_code LIKE concat('%', #{bo.itemCode}, '%')
            </if>
            <if test="bo.instanceCode != null and bo.instanceCode != ''">
                AND d.instance_code LIKE concat('%', #{bo.instanceCode}, '%')
            </if>
            <if test="bo.shipmentOrderId != null">
                AND d.shipment_order_id = #{bo.shipmentOrderId}
            </if>
            <if test="bo.warehouseId != null">
                AND d.warehouse_id = #{bo.warehouseId}
            </if>
            <if test="bo.areaId != null">
                AND d.area_id = #{bo.areaId}
            </if>
            <if test="bo.startTime != null and bo.startTime != ''">
                AND d.create_time &gt;= #{bo.startTime}
            </if>
            <if test="bo.endTime != null and bo.endTime != ''">
                AND d.create_time &lt;= #{bo.endTime}
            </if>
        </where>
        ORDER BY d.create_time DESC
    </select>

</mapper>
